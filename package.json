{
  "name": "achievement-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-bundle.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/achievement/expression.test.ts src/achievement/definitions.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@avg-studio/sdk": "file:./sdk",
    "@types/node": "^20.11.30",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.1.3",
    "vite": "^5.3.1"
  }
}
